{
  "name": "Bill",
  "type": "object",
  "properties": {
    "provider_name": {
      "type": "string",
      "description": "Nombre del proveedor del servicio"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "luz",
        "gas",
        "agua",
        "internet",
        "telefono",
        "impuesto",
        "alquiler",
        "otros"
      ],
      "default": "otros",
      "description": "Tipo de servicio"
    },
    "reference": {
      "type": "string",
      "description": "N\u00famero de factura o referencia"
    },
    "amount": {
      "type": "number",
      "description": "Monto a pagar"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ARS",
        "USD"
      ],
      "default": "ARS"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "scheduled"
      ],
      "default": "pending"
    },
    "account_id": {
      "type": "string",
      "description": "Cuenta de pago"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se pag\u00f3"
    }
  },
  "required": [
    "provider_name",
    "service_type",
    "amount",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}