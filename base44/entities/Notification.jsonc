{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo de la notificaci\u00f3n"
    },
    "message": {
      "type": "string",
      "description": "Mensaje descriptivo"
    },
    "type": {
      "type": "string",
      "enum": [
        "transfer",
        "payment",
        "collection",
        "system",
        "security",
        "alert",
        "investment"
      ],
      "default": "system",
      "description": "Tipo de notificaci\u00f3n"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Si fue le\u00edda"
    },
    "link": {
      "type": "string",
      "description": "Ruta interna a la que dirige"
    },
    "amount": {
      "type": "number",
      "description": "Monto relacionado (opcional)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ARS",
        "USD"
      ],
      "default": "ARS"
    }
  },
  "required": [
    "title",
    "message",
    "type"
  ]
}