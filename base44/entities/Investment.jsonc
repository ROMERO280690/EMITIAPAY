{
  "name": "Investment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "plazo_fijo",
        "fci",
        "acciones",
        "bonos"
      ],
      "default": "plazo_fijo",
      "description": "Tipo de inversi\u00f3n"
    },
    "amount": {
      "type": "number",
      "description": "Monto invertido"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ARS",
        "USD"
      ],
      "default": "ARS"
    },
    "duration_days": {
      "type": "number",
      "description": "Plazo en d\u00edas"
    },
    "rate": {
      "type": "number",
      "description": "TNA aplicada"
    },
    "expected_yield": {
      "type": "number",
      "description": "Rendimiento estimado"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "maturity_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "matured",
        "cancelled"
      ],
      "default": "active"
    },
    "account_id": {
      "type": "string",
      "description": "Cuenta desde la que se invirti\u00f3"
    }
  },
  "required": [
    "type",
    "amount",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}